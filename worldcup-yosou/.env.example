# ── データベース ────────────────────────────────────────────
# ローカル開発（SQLite）。プロジェクト直下の dev.db を使います。
DATABASE_URL="file:./dev.db"
#
# 本番（Vercel など / Postgres）の例:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
#   ※ src/lib/prisma.ts と prisma/schema.prisma を Postgres 用に切り替えてください（README参照）

# ── 管理画面の認証 ──────────────────────────────────────────
# 管理画面（/admin）のログインパスワード。未設定時の仮値は admin2026。
ADMIN_PASSWORD="admin2026"
# セッショントークン署名用のシークレット（本番では必ずランダムな値に変更）。
ADMIN_SECRET="change-me-to-a-random-secret"
