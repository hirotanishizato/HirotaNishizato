# ── データベース（PostgreSQL）────────────────────────────────
# 接続文字列。ローカルは自前のPostgres、本番(Render)はManaged Postgresの
# Internal/External Database URL を設定します。
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
#
# ローカル開発例（自前Postgres）:
# DATABASE_URL="postgresql://wc:wc@127.0.0.1:5432/worldcup"

# ── 管理画面の認証 ──────────────────────────────────────────
# 管理画面（/admin）のログインパスワード。未設定時の仮値は admin2026。
ADMIN_PASSWORD="admin2026"
# セッショントークン署名用のシークレット（本番では必ずランダムな値に変更）。
ADMIN_SECRET="change-me-to-a-random-secret"
