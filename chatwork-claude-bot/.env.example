# Chatwork × Claude 連携ボットの環境変数サンプル。
# このファイルを .env にコピーして値を入れる(ローカル開発用)。
# 本番(Render)ではダッシュボードの Environment に同じキーを設定する。

# Chatwork の APIトークン(操作用)。「APIトークン」画面で取得。
# ※ 一度チャット等に貼ってしまった場合は必ず再発行すること。
CHATWORK_API_TOKEN=

# Webhook 作成後に表示される署名検証用トークン。
CHATWORK_WEBHOOK_TOKEN=

# Anthropic(Claude)の APIキー。
ANTHROPIC_API_KEY=

# 任意設定(未設定なら既定値が使われる)
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_MAX_TOKENS=1024
# SYSTEM_PROMPT=あなたはChatwork上で動作する丁寧な日本語アシスタントです。
# PORT=3000
