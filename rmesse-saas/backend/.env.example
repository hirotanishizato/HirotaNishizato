# --- Database ---
# Dev (SQLite): sqlite:///./dev.db
# Prod (PostgreSQL): postgresql+psycopg://user:pass@localhost:5432/rmesse
DATABASE_URL=sqlite:///./dev.db

# --- Auth ---
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Provider ---
# openai | gemini
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Rakuten RMS ---
# 個別ショップごとのキーはDBに保存。これらはシステム共通のデフォルト/SaaS運営側用。
RMS_API_BASE=https://api.rms.rakuten.co.jp
# true にすると外部API呼び出しをモックに差し替え（開発用）
RMS_MOCK_MODE=true

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
