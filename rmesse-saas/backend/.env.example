# --- Database ---
# Dev (SQLite): sqlite:///./dev.db
# Prod (PostgreSQL): postgresql+psycopg://user:pass@localhost:5432/rmesse
DATABASE_URL=sqlite:///./dev.db

# --- Auth ---
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 秘匿情報(RMS資格情報等)の暗号化キー (Fernet urlsafe-base64 32B 推奨)。
# 生成例: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 未設定時は JWT_SECRET から派生（開発用）。本番では必ず独立した強い鍵を設定すること。
SECRET_ENCRYPTION_KEY=

# --- AI Provider ---
# openai | gemini
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Rakuten RMS ---
# 個別ショップごとのキーはDBに保存。これらはシステム共通のデフォルト/SaaS運営側用。
RMS_API_BASE=https://api.rms.rakuten.co.jp
# true にすると外部API呼び出しをモックに差し替え（開発用）
RMS_MOCK_MODE=true

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
